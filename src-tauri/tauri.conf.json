{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "speeddf",
	"version": "1.2.3",
	"identifier": "com.speeddf.doc",
	"plugins": {
		"updater": {
			"endpoints": [
				"https://speeddf.com/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5OTc3OENBQkYyMzA2QTgKUldTb0JpTy95bmlYbVI2d01NRE5YVzhNYzNDZmRMR1BUa0tOVVlPRytPUG1hUEpRYlluQTM3QjEK"
		}
	},
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "speeddf",
				"width": 800,
				"height": 600,
				"resizable": true,
				"decorations": false,
				"visible": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self' customprotocol: asset: data: blob:",
				"connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://tauri.localhost https://tauri.localhost tauri: ws: wss: https://speeddf.com",
				"font-src": "'self' data:",
				"img-src": "'self' asset: http://asset.localhost https://asset.localhost http://tauri.localhost https://tauri.localhost tauri: blob: data:",
				"style-src": "'self' 'unsafe-inline'",
				"script-src": "'self' 'wasm-unsafe-eval' 'unsafe-inline' 'unsafe-eval'",
				"worker-src": "'self' blob:",
				"object-src": "'none'"
			},
			"devCsp": {
				"default-src": "'self' customprotocol: asset: data: blob:",
				"connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://tauri.localhost https://tauri.localhost tauri: ws: wss: http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 https://speeddf.com",
				"font-src": "'self' data:",
				"img-src": "'self' asset: http://asset.localhost https://asset.localhost http://tauri.localhost https://tauri.localhost tauri: blob: data:",
				"style-src": "'self' 'unsafe-inline'",
				"script-src": "'self' 'wasm-unsafe-eval' 'unsafe-inline' 'unsafe-eval'",
				"worker-src": "'self' blob:",
				"object-src": "'none'"
			},
			"dangerousDisableAssetCspModification": [
				"style-src"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"fileAssociations": [
			{
				"ext": [
					"pdf"
				],
				"name": "PDF Document",
				"description": "Portable Document Format",
				"role": "Editor"
			},
			{
				"ext": [
					"tiff",
					"tif"
				],
				"name": "TIFF Document",
				"description": "Multi-page Technical TIFF Drawing",
				"role": "Editor"
			},
			{
				"ext": [
					"png",
					"jpg",
					"jpeg",
					"webp",
					"bmp",
					"svg"
				],
				"name": "Image File",
				"description": "Image Document (including SVG)",
				"role": "Editor"
			},
			{
				"ext": [
					"heic",
					"heif"
				],
				"name": "HEIC Image",
				"description": "iPhone HEIC/HEIF Photo",
				"role": "Editor"
			},
			{
				"ext": [
					"md",
					"markdown"
				],
				"name": "Markdown Document",
				"description": "Markdown text document",
				"role": "Viewer"
			}
		]
	}
}